<InsertScreen>:
	property_code: property_code
	property_type: property_type
	year_construction: year_construction
	building_type: building_type
	unit_measurement: unit_measurement
	facade: facade
	depth: depth
	floors: floors
	area: area
	bedrooms: bedrooms
	bathrooms: bathrooms
	corner_yes: corner_yes
	corner_no: corner_no
	offer_type: offer_type
	governorate: governorate
	region: region
	price: price
	price_dinar: price_dinar
	price_dollar: price_dollar
	property_owner: property_owner
	add_photo: add_photo
	photo_count: photo_count
	photo_gallery: photo_gallery
	address: address
	notes: notes
	save_btn: save_btn
	new_btn: new_btn

	BoxLayout:
		orientation: 'vertical'
		padding: 20
		spacing: 10
		canvas.before:
			Color:
				rgba: 0.95, 0.95, 0.95, 1
			Rectangle:
				pos: self.pos
				size: self.size

		# Top navigation bar with language button
		BoxLayout:
			orientation: 'horizontal'
			size_hint_y: None
			height: '50dp'
			spacing: '15dp'
			padding: [0, 0, 0, 10]

			# Language button
			Button:
				size_hint_x: None
				width: '120dp'
				text: 'Language'
				font_size: '14sp'
				background_color: 0.2, 0.8, 0.6, 1
				color: 1, 1, 1, 1
				on_release: root.show_language_switcher()

			Widget:  # Spacer

		# Header
		BoxLayout:
			size_hint_y: None
			height: 50
			padding: [0, 0, 0, 10]
			Label:
				id: header_label
				text: 'Add New Property'
				font_size: 24
				color: 0.2, 0.2, 0.2, 1
				bold: True

		ScrollView:
			do_scroll_x: False
			do_scroll_y: True
			BoxLayout:
				orientation: 'vertical'
				size_hint_y: None
				height: self.minimum_height
				spacing: 15

				# Grid layout for form fields - 2 columns for better responsiveness
				GridLayout:
					cols: 2
					spacing: 10, 15
					padding: 5
					size_hint_y: None
					height: self.minimum_height

					# 1. Property Code
					Label:
						id: property_code_label
						text: 'Property Code'
						size_hint_y: None
						height: 40
						color: 0.2, 0.2, 0.2, 1
					TextInput:
						id: property_code
						multiline: False
						hint_text: 'Auto-generated if empty'
						size_hint_y: None
						height: 40
					# 2. Property Type
					Label:
						id: property_type_label
						text: 'Property Type*'
						size_hint_y: None
						height: 40
						color: 0.2, 0.2, 0.2, 1
					Spinner:
						id: property_type
						text: 'Select Type'
						values: ['House', 'Apartment', 'Land', 'Commercial']
						size_hint_y: None
						height: 40
						background_color: 0.9, 0.9, 0.9, 1

					# 3. Year of Construction
					Label:
						id: year_construction_label
						text: 'Year of Construction'
						size_hint_y: None
						height: 40
						color: 0.2, 0.2, 0.2, 1
					TextInput:
						id: year_construction
						multiline: False
						input_filter: 'int'
						hint_text: 'Enter year (e.g., 2020)'
						size_hint_y: None
						height: 40

					# 4. Building Type
					Label:
						id: building_type_label
						text: 'Building Type*'
						size_hint_y: None
						height: 40
						color: 0.2, 0.2, 0.2, 1
					Spinner:
						id: building_type
						text: 'Select Building Type'
						values: ['Concrete', 'Brick', 'Steel', 'Other']
						size_hint_y: None
						height: 40
						background_color: 0.9, 0.9, 0.9, 1

					# 5. Unit of Measurement
					Label:
						id: unit_measurement_label
						text: 'Unit of Measurement'
						size_hint_y: None
						height: 40
						color: 0.2, 0.2, 0.2, 1
					Spinner:
						id: unit_measurement
						text: 'Select Unit'
						values: ['m²', 'ft²']
						size_hint_y: None
						height: 40
						background_color: 0.9, 0.9, 0.9, 1


					# 6. Facade
					Label:
						id: facade_label
						text: 'Facade'
						size_hint_y: None
						height: 40
						color: 0.2, 0.2, 0.2, 1
					TextInput:
						id: facade
						multiline: False
						hint_text: 'Enter facade measurement'
						input_filter: 'float'
						size_hint_y: None
						height: 40

					# 6b. Depth
					Label:
						id: depth_label
						text: 'Depth'
						size_hint_y: None
						height: 40
						color: 0.2, 0.2, 0.2, 1
					TextInput:
						id: depth
						multiline: False
						hint_text: 'Enter depth measurement'
						input_filter: 'float'
						size_hint_y: None
						height: 40

					# 7. Floors/Levels
					Label:
						id: floors_label
						text: 'Floors/Levels'
						size_hint_y: None
						height: 40
						color: 0.2, 0.2, 0.2, 1
					TextInput:
						id: floors
						multiline: False
						input_filter: 'int'
						hint_text: 'Enter number of floors'
						size_hint_y: None
						height: 40

					# 8. Area
					Label:
						id: area_label
						text: 'Area'
						size_hint_y: None
						height: 40
						color: 0.2, 0.2, 0.2, 1
					TextInput:
						id: area
						multiline: False
						input_filter: 'float'
						hint_text: 'Enter area'
						size_hint_y: None
						height: 40

					# 9. Number of Bedrooms
					Label:
						id: bedrooms_label
						text: 'Bedrooms'
						size_hint_y: None
						height: 40
						color: 0.2, 0.2, 0.2, 1
					TextInput:
						id: bedrooms
						multiline: False
						input_filter: 'int'
						hint_text: 'Enter number of bedrooms'
						size_hint_y: None
						height: 40

					# 10. Number of Bathrooms
					Label:
						id: bathrooms_label
						text: 'Bathrooms'
						size_hint_y: None
						height: 40
						color: 0.2, 0.2, 0.2, 1
					TextInput:
						id: bathrooms
						multiline: False
						input_filter: 'int'
						hint_text: 'Enter number of bathrooms'
						size_hint_y: None
						height: 40
					# 11. Corner or Not?
					Label:
						id: corner_label
						text: 'Corner?'
						size_hint_y: None
						height: 40
						color: 0.2, 0.2, 0.2, 1
					BoxLayout:
						size_hint_y: None
						height: 40
						CheckBox:
							id: corner_yes
							group: 'corner'
						Label:
							id: yes_label
							text: 'Yes'
							size_hint_x: 0.3
						CheckBox:
							id: corner_no
							group: 'corner'
						Label:
							id: no_label
							text: 'No'
							size_hint_x: 0.3

					# 12. Offer Type
					Label:
						id: offer_type_label
						text: 'Offer Type'
						size_hint_y: None
						height: 40
						color: 0.2, 0.2, 0.2, 1
					Spinner:
						id: offer_type
						text: 'Select Offer Type'
						values: ['Sale', 'Rent', 'Lease']
						size_hint_y: None
						height: 40
						background_color: 0.9, 0.9, 0.9, 1

					# 13. Province/Governorate
					Label:
						id: governorate_label
						text: 'Province/Governorate*'
						size_hint_y: None
						height: 40
						color: 0.2, 0.2, 0.2, 1
					Spinner:
						id: governorate
						text: 'Select Province'
						values: []
						size_hint_y: None
						height: 40
						background_color: 0.9, 0.9, 0.9, 1
						on_text: root.on_province_selected(self.text)


					# 14. Region/Area
					Label:
						id: region_label
						text: 'Region/Area*'
						size_hint_y: None
						height: 40
						color: 0.2, 0.2, 0.2, 1
					Spinner:
						id: region
						text: 'Select Region'
						values: []
						size_hint_y: None
						height: 40
						background_color: 0.9, 0.9, 0.9, 1

					# 14b. Property Address
					Label:
						id: address_label
						text: 'Property Address'
						size_hint_y: None
						height: 40
						color: 0.2, 0.2, 0.2, 1
					TextInput:
						id: address
						multiline: False
						hint_text: 'Enter property address'
						size_hint_y: None
						height: 40

					# 15. Price
					Label:
						id: price_label
						text: 'Price'
						size_hint_y: None
						height: 40
						color: 0.2, 0.2, 0.2, 1
					BoxLayout:
						size_hint_y: None
						height: 40
						TextInput:
							id: price
							multiline: False
							input_filter: 'float'
							hint_text: 'Enter price'
							size_hint_x: 0.6
						ToggleButton:
							id: price_dinar
							text: 'Dinar'
							group: 'currency'
							size_hint_x: 0.2
						ToggleButton:
							id: price_dollar
							text: 'Dollar'
							group: 'currency'
							size_hint_x: 0.2

					# 16. Property Owner
					Label:
						id: owner_label
						text: 'Property Owner*'
						size_hint_y: None
						height: 40
						color: 0.2, 0.2, 0.2, 1
					BoxLayout:
						size_hint_y: None
						height: 40
						spacing: 5
						orientation: 'horizontal'
						TextInput:
							id: owner_search
							hint_text: 'Search owner by name/code'
							multiline: False
							size_hint_x: 0.5
							on_text: root.filter_owners(self.text)
						Spinner:
							id: property_owner
							text: 'Select Owner'
							values: []
							size_hint_x: 0.35
						Button:
							text: 'Add Owner'
							size_hint_x: 0.15
							background_color: 0.3, 0.6, 0.9, 1
							color: 1, 1, 1, 1
							on_press: root.show_owner_form(self)

					# 17. Photos
					Label:
						id: photos_label
						text: 'Photos'
						size_hint_y: None
						height: 40
						color: 0.2, 0.2, 0.2, 1
					BoxLayout:
						size_hint_y: None
						height: 40
						orientation: 'horizontal'
						spacing: 10
						Button:
							id: add_photo
							text: 'Add Photo'
							background_color: 0.3, 0.6, 0.9, 1
							color: 1, 1, 1, 1
							size_hint_x: 0.3
							on_press: root.show_file_chooser(self)
						Label:
							id: photo_count
							text: 'No photos selected'
							color: 0.5, 0.5, 0.5, 1
							size_hint_x: 0.7
							halign: app.rtl and 'right' or 'left'
							valign: 'middle'
							text_size: self.size

				# Photo Preview Gallery
				BoxLayout:
					size_hint_y: None
					height: 150
					orientation: 'vertical'
					spacing: 5

					Label:
						text: 'Photo Preview'
						size_hint_y: None
						height: 30
						color: 0.2, 0.2, 0.2, 1
						halign: app.rtl and 'right' or 'left'
						valign: 'middle'
						text_size: self.size

					ScrollView:
						do_scroll_y: False
						do_scroll_x: True
						size_hint_y: None
						height: 115

						GridLayout:
							id: photo_gallery
							rows: 1
							size_hint_x: None
							width: self.minimum_width
							spacing: 10
							height: 100

				# 18. Notes - full width
				BoxLayout:
					size_hint_y: None
					height: 120
					orientation: 'vertical'
					spacing: 5

					Label:
						id: notes_label
						text: 'Notes'
						size_hint_y: None
						height: 30
						color: 0.2, 0.2, 0.2, 1
						halign: app.rtl and 'right' or 'left'
						valign: 'middle'
						text_size: self.size

					TextInput:
						id: notes
						multiline: True
						hint_text: 'Enter any additional notes about the property'
						size_hint_y: None
						height: 80
		# Required fields notice
		Label:
			id: required_fields_label
			text: '* Required fields'
			size_hint_y: None
			height: 20
			color: 0.5, 0.5, 0.5, 1
			halign: app.rtl and 'right' or 'left'
			text_size: self.size

		# Action buttons
		BoxLayout:
			size_hint_y: None
			height: 60
			spacing: 20
			# Two-value padding (top/bottom) is unchanged; no left/right swap needed
			padding: [0, 10]

			Button:
				id: back_btn
				text: 'Back'
				size_hint_x: None
				width: 100
				background_color: 0.4, 0.4, 0.8, 1
				color: 1, 1, 1, 1
				on_press: app.sm.current = 'main_gui'

			Widget:
				# Spacer

			Button:
				id: new_btn
				text: 'Clear Form'
				background_color: 0.4, 0.6, 0.8, 1
				color: 1, 1, 1, 1
				size_hint_x: None
				width: 150
				on_press: root.on_new()

			Button:
				id: save_btn
				text: 'Save Property'
				background_color: 0.2, 0.8, 0.3, 1
				color: 1, 1, 1, 1
				size_hint_x: None
				width: 150
				on_press: root.on_save()
