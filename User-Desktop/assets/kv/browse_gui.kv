<SearchReportScreen>:
    name: 'search_report'

    # White background
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 15

        # Screen title
        Label:
            text: 'Property Search & Reports - البحث عن العقارات والتقارير'
            font_size: 28
            size_hint_y: None
            height: 50
            color: 0.1, 0.1, 0.1, 1
            bold: True

        # Search criteria section
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: 320
            spacing: 10

            # Section title
            Label:
                text: 'Search Criteria - معايير البحث'
                font_size: 18
                size_hint_y: None
                height: 30
                color: 0.2, 0.2, 0.2, 1
                bold: True
                halign: 'left'
                text_size: self.size

            # Search form
            GridLayout:
                cols: 4
                spacing: 15
                size_hint_y: None
                height: 280
                row_default_height: 60

                # Property type row
                Label:
                    text: 'Property Type - نوع العقار:'
                    color: 0, 0, 0, 1
                    size_hint_y: None
                    height: 30
                    halign: 'right'
                    valign: 'middle'
                    text_size: self.size

                Spinner:
                    id: property_type_spinner
                    text: 'All Types - جميع الأنواع'
                    values: ['All Types - جميع الأنواع']
                    size_hint_y: None
                    height: 40

                # Building type row
                Label:
                    text: 'Building Type - نوع البناء:'
                    color: 0, 0, 0, 1
                    size_hint_y: None
                    height: 30
                    halign: 'right'
                    valign: 'middle'
                    text_size: self.size

                Spinner:
                    id: building_type_spinner
                    text: 'All Types - جميع الأنواع'
                    values: ['All Types - جميع الأنواع']
                    size_hint_y: None
                    height: 40

                # Min bedrooms row
                Label:
                    text: 'Min Bedrooms - أقل عدد غرف النوم:'
                    color: 0, 0, 0, 1
                    size_hint_y: None
                    height: 30
                    halign: 'right'
                    valign: 'middle'
                    text_size: self.size

                TextInput:
                    id: min_bedrooms
                    multiline: False
                    size_hint_y: None
                    height: 40
                    input_filter: 'int'

                # Max bedrooms row
                Label:
                    text: 'Max Bedrooms - أكثر عدد غرف النوم:'
                    color: 0, 0, 0, 1
                    size_hint_y: None
                    height: 30
                    halign: 'right'
                    valign: 'middle'
                    text_size: self.size

                TextInput:
                    id: max_bedrooms
                    multiline: False
                    size_hint_y: None
                    height: 40
                    input_filter: 'int'

                # Min price row
                Label:
                    text: 'Min Price - أقل سعر:'
                    color: 0, 0, 0, 1
                    size_hint_y: None
                    height: 30
                    halign: 'right'
                    valign: 'middle'
                    text_size: self.size

                TextInput:
                    id: min_price
                    multiline: False
                    size_hint_y: None
                    height: 40
                    input_filter: 'float'

                # Max price row
                Label:
                    text: 'Max Price - أعلى سعر:'
                    color: 0, 0, 0, 1
                    size_hint_y: None
                    height: 30
                    halign: 'right'
                    valign: 'middle'
                    text_size: self.size

                TextInput:
                    id: max_price
                    multiline: False
                    size_hint_y: None
                    height: 40
                    input_filter: 'float'

                # Corner property row
                Label:
                    text: 'Corner Property - عقار زاوية:'
                    color: 0, 0, 0, 1
                    size_hint_y: None
                    height: 30
                    halign: 'right'
                    valign: 'middle'
                    text_size: self.size

                CheckBox:
                    id: corner_property
                    size_hint_y: None
                    height: 40
                    active: False

            # Search buttons
            BoxLayout:
                orientation: 'horizontal'
                spacing: 15
                size_hint_y: None
                height: 50

                Button:
                    text: 'Search - بحث'
                    size_hint: 0.2, 1
                    background_color: 0.2, 0.6, 0.8, 1
                    color: 1, 1, 1, 1
                    font_size: 14
                    on_press: root.perform_search(self)

                Button:
                    text: 'Clear Search - مسح البحث'
                    size_hint: 0.2, 1
                    background_color: 0.6, 0.6, 0.6, 1
                    color: 1, 1, 1, 1
                    font_size: 14
                    on_press: root.clear_search(self)

                Button:
                    text: 'Export Results - تصدير النتائج'
                    size_hint: 0.2, 1
                    background_color: 0.6, 0.8, 0.2, 1
                    color: 1, 1, 1, 1
                    font_size: 14
                    on_press: root.export_results(self)

                Button:
                    text: 'Go Back - العودة'
                    size_hint: 0.2, 1
                    background_color: 0.8, 0.2, 0.2, 1
                    color: 1, 1, 1, 1
                    font_size: 14
                    on_press: root.go_to_main_gui(self)

                Label:  # Spacer

        # Results section
        BoxLayout:
            orientation: 'vertical'
            spacing: 10

            # Results title
            Label:
                text: 'Search Results - نتائج البحث'
                font_size: 18
                size_hint_y: None
                height: 30
                color: 0.2, 0.2, 0.2, 1
                bold: True
                halign: 'left'
                text_size: self.size

            # Results scroll area
            ScrollView:
                id: results_scroll

                BoxLayout:
                    id: results_layout
                    orientation: 'vertical'
                    spacing: 2
                    size_hint_y: None
                    height: self.minimum_height