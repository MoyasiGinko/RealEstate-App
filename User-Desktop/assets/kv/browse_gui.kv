<SearchReportScreen>:
    name: 'search_report'

<PropertyDetailPopup>:
    title: 'Property Details'
    size_hint: 0.9, 0.9

    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 15

        # Main content area
        BoxLayout:
            orientation: 'horizontal'
            spacing: 20

            # Property details on the left
            ScrollView:
                size_hint: 0.6, 1

                GridLayout:
                    id: details_grid
                    cols: 2
                    spacing: 10
                    size_hint_y: None
                    height: self.minimum_height
                    padding: 10

            # Photo gallery on the right
            BoxLayout:
                orientation: 'vertical'
                size_hint: 0.4, 1

                Label:
                    text: 'Property Photos'
                    size_hint_y: None
                    height: 40
                    font_size: 18
                    color: 0.2, 0.2, 0.2, 1
                    bold: True

                ScrollView:
                    GridLayout:
                        id: photo_gallery
                        cols: 1
                        spacing: 10
                        size_hint_y: None
                        height: self.minimum_height
                        padding: 10

        # Close button
        Button:
            text: 'Close'
            size_hint_y: None
            height: 50
            background_color: 0.6, 0.6, 0.6, 1
            color: 1, 1, 1, 1
            on_press: root.dismiss()