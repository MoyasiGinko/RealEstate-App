<SearchReportScreen>:
    name: 'search_report'

    # White background
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 15

        # Screen title with language switcher
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: 50
            spacing: 20

            Label:
                id: screen_title
                text: 'Property Search & Reports'
                font_size: 28
                color: 0.1, 0.1, 0.1, 1
                bold: True
                halign: 'left'
                valign: 'middle'
                text_size: self.size

            # Language switcher button
            Button:
                id: language_btn
                text: '🌐 Language'
                size_hint: None, None
                size: 120, 40
                pos_hint: {'center_y': 0.5}
                background_color: 0.2, 0.6, 0.9, 1
                color: 1, 1, 1, 1
                font_size: 14
                on_press: root.show_language_switcher()

        # Search criteria section
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: 320
            spacing: 10

            # Section title
            # Label:
            #     id: search_criteria_label
            #     text: 'Search Criteria'
            #     font_size: 18
            #     size_hint_y: None
            #     height: 30
            #     color: 0.2, 0.2, 0.2, 1
            #     bold: True
            #     halign: 'left'
            #     text_size: self.size

            # Search form
            GridLayout:
                cols: 4
                spacing: 15
                size_hint_y: None
                height: 280
                row_default_height: 60

                # Property type row
                Label:
                    id: property_type_label
                    text: 'Property Type'
                    color: 0, 0, 0, 1
                    size_hint_y: None
                    height: 30
                    halign: 'right'
                    valign: 'middle'
                    text_size: self.size

                Spinner:
                    id: property_type_spinner
                    text: 'All Types'
                    values: ['All Types']
                    size_hint_y: None
                    height: 40

                # Building type row
                Label:
                    id: building_type_label
                    text: 'Building Type'
                    color: 0, 0, 0, 1
                    size_hint_y: None
                    height: 30
                    halign: 'right'
                    valign: 'middle'
                    text_size: self.size

                Spinner:
                    id: building_type_spinner
                    text: 'All Types'
                    values: ['All Types']
                    size_hint_y: None
                    height: 40

                # Min bedrooms row
                Label:
                    id: min_bedrooms_label
                    text: 'Min Bedrooms'
                    color: 0, 0, 0, 1
                    size_hint_y: None
                    height: 30
                    halign: 'right'
                    valign: 'middle'
                    text_size: self.size

                TextInput:
                    id: min_bedrooms
                    multiline: False
                    size_hint_y: None
                    height: 40
                    input_filter: 'int'

                # Max bedrooms row
                Label:
                    id: max_bedrooms_label
                    text: 'Max Bedrooms'
                    color: 0, 0, 0, 1
                    size_hint_y: None
                    height: 30
                    halign: 'right'
                    valign: 'middle'
                    text_size: self.size

                TextInput:
                    id: max_bedrooms
                    multiline: False
                    size_hint_y: None
                    height: 40
                    input_filter: 'int'

                # Min price row
                Label:
                    id: min_price_label
                    text: 'Min Price'
                    color: 0, 0, 0, 1
                    size_hint_y: None
                    height: 30
                    halign: 'right'
                    valign: 'middle'
                    text_size: self.size

                TextInput:
                    id: min_price
                    multiline: False
                    size_hint_y: None
                    height: 40
                    input_filter: 'float'

                # Max price row
                Label:
                    id: max_price_label
                    text: 'Max Price'
                    color: 0, 0, 0, 1
                    size_hint_y: None
                    height: 30
                    halign: 'right'
                    valign: 'middle'
                    text_size: self.size

                TextInput:
                    id: max_price
                    multiline: False
                    size_hint_y: None
                    height: 40
                    input_filter: 'float'

                # Corner property row
                Label:
                    id: corner_property_label
                    text: 'Corner Property'
                    color: 0, 0, 0, 1
                    size_hint_y: None
                    height: 30
                    halign: 'right'
                    valign: 'middle'
                    text_size: self.size

                CheckBox:
                    id: corner_property
                    size_hint_y: None
                    height: 40
                    active: False

            # Search buttons
            BoxLayout:
                orientation: 'horizontal'
                spacing: 15
                size_hint_y: None
                height: 50

                Button:
                    id: search_btn
                    text: 'Search'
                    size_hint: 0.2, 1
                    background_color: 0.2, 0.6, 0.8, 1
                    color: 1, 1, 1, 1
                    font_size: 14
                    on_press: root.perform_search(self)

                Button:
                    id: clear_search_btn
                    text: 'Clear Search'
                    size_hint: 0.2, 1
                    background_color: 0.6, 0.6, 0.6, 1
                    color: 1, 1, 1, 1
                    font_size: 14
                    on_press: root.clear_search(self)

                Button:
                    id: export_results_btn
                    text: 'Export Results'
                    size_hint: 0.2, 1
                    background_color: 0.6, 0.8, 0.2, 1
                    color: 1, 1, 1, 1
                    font_size: 14
                    on_press: root.export_results(self)

                Button:
                    id: go_back_btn
                    text: 'Go Back'
                    size_hint: 0.2, 1
                    background_color: 0.8, 0.2, 0.2, 1
                    color: 1, 1, 1, 1
                    font_size: 14
                    on_press: root.go_to_main_gui(self)

                Label:  # Spacer

        # Results section
        BoxLayout:
            orientation: 'vertical'
            spacing: 10

            # Results title
            Label:
                id: results_title
                text: 'Search Results'
                font_size: 18
                size_hint_y: None
                height: 30
                color: 0.2, 0.2, 0.2, 1
                bold: True
                halign: 'left'
                text_size: self.size

            # Results scroll area
            ScrollView:
                id: results_scroll

                BoxLayout:
                    id: results_layout
                    orientation: 'vertical'
                    spacing: 2
                    size_hint_y: None
                    height: self.minimum_height