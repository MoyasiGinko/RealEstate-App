<PropertyForm@BoxLayout>:
    orientation: 'vertical'
    padding: 30, 30, 30, 30
    spacing: 20
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size

    Label:
        id: form_title_label
        text: 'Property Form'
        font_size: 22
        color: 0.2, 0.2, 0.2, 1
        size_hint_y: None
        height: 40



    ScrollView:
        do_scroll_x: False
        do_scroll_y: True
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            spacing: 15
            GridLayout:
                id: form_grid
                cols: 2
                spacing: 16
                padding: 10, 10, 10, 10
                size_hint_y: None
                height: self.minimum_height
                size_hint_x: None
                width: self.parent.width if self.parent else 600
                row_default_height: 48
                row_force_default: True

                # Property Type
                Label:
                    id: property_type_label
                    text: 'Property Type:'
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.4
                Spinner:
                    id: property_type
                    text: 'Select Property Type'
                    values: root.property_type_values if hasattr(root, 'property_type_values') else []
                    background_color: 0.95, 0.95, 0.95, 1
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.6
                    minimum_width: 180

                # Building Type
                Label:
                    id: building_type_label
                    text: 'Building Type:'
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.4
                Spinner:
                    id: building_type
                    text: 'Select Building Type'
                    values: root.building_type_values if hasattr(root, 'building_type_values') else []
                    background_color: 0.95, 0.95, 0.95, 1
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.6
                    minimum_width: 180

                # Year Built
                Label:
                    id: year_built_label
                    text: 'Year Built:'
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.4
                Spinner:
                    id: year_spinner
                    text: 'Select Year'
                    values: root.year_values if hasattr(root, 'year_values') else []
                    background_color: 0.95, 0.95, 0.95, 1
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.6
                    minimum_width: 120

                # Area
                Label:
                    id: area_label
                    text: 'Area:'
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.4
                TextInput:
                    id: area
                    hint_text: 'Property Area'
                    input_filter: 'float'
                    multiline: False
                    background_color: 0.98, 0.98, 0.98, 1
                    foreground_color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.6
                    minimum_width: 120

                # Facade
                Label:
                    id: facade_label
                    text: 'Facade:'
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.4
                TextInput:
                    id: facade
                    hint_text: 'Facade Length'
                    input_filter: 'float'
                    multiline: False
                    background_color: 0.98, 0.98, 0.98, 1
                    foreground_color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.6
                    minimum_width: 120

                # Depth
                Label:
                    id: depth_label
                    text: 'Depth:'
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.4
                TextInput:
                    id: depth
                    hint_text: 'Property Depth'
                    input_filter: 'float'
                    multiline: False
                    background_color: 0.98, 0.98, 0.98, 1
                    foreground_color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.6
                    minimum_width: 120

                # Bedrooms
                Label:
                    id: bedrooms_label
                    text: 'Bedrooms:'
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.4
                TextInput:
                    id: bedrooms
                    hint_text: 'Number of Bedrooms'
                    input_filter: 'int'
                    multiline: False
                    background_color: 0.98, 0.98, 0.98, 1
                    foreground_color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.6
                    minimum_width: 120

                # Bathrooms
                Label:
                    id: bathrooms_label
                    text: 'Bathrooms:'
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.4
                TextInput:
                    id: bathrooms
                    hint_text: 'Number of Bathrooms'
                    input_filter: 'int'
                    multiline: False
                    background_color: 0.98, 0.98, 0.98, 1
                    foreground_color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.6
                    minimum_width: 120

                # Is Corner Property
                Label:
                    id: corner_label
                    text: 'Is Corner Property:'
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.4
                CheckBox:
                    id: corner
                    size_hint_x: 0.6

                # Offer Type
                Label:
                    id: offer_type_label
                    text: 'Offer Type:'
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.4
                Spinner:
                    id: offer_type
                    text: 'Select Offer Type'
                    values: root.offer_type_values if hasattr(root, 'offer_type_values') else []
                    background_color: 0.95, 0.95, 0.95, 1
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.6
                    minimum_width: 120

                # Province
                Label:
                    id: province_label
                    text: 'Province:'
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.4
                Spinner:
                    id: province
                    text: 'Select Province'
                    values: root.province_values if hasattr(root, 'province_values') else []
                    background_color: 0.95, 0.95, 0.95, 1
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.6
                    minimum_width: 120

                # Region
                Label:
                    id: region_label
                    text: 'Region:'
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.4
                Spinner:
                    id: region
                    text: 'Select Region'
                    values: root.region_values if hasattr(root, 'region_values') else []
                    background_color: 0.95, 0.95, 0.95, 1
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.6
                    minimum_width: 120

                # Address
                Label:
                    id: address_label
                    text: 'Address:'
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.4
                TextInput:
                    id: address
                    hint_text: 'Property Address'
                    multiline: True
                    background_color: 0.98, 0.98, 0.98, 1
                    foreground_color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.6
                    minimum_width: 180

                # Owner
                Label:
                    id: owner_label
                    text: 'Owner:'
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.4
                Spinner:
                    id: owner
                    text: 'Select Owner'
                    values: root.owner_values if hasattr(root, 'owner_values') else []
                    background_color: 0.95, 0.95, 0.95, 1
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.6
                    minimum_width: 120

                # Description
                Label:
                    id: description_label
                    text: 'Description:'
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.4
                TextInput:
                    id: description
                    hint_text: 'Property Description'
                    multiline: True
                    background_color: 0.98, 0.98, 0.98, 1
                    foreground_color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.6
                    minimum_width: 180

                # Floors
                Label:
                    id: floors_label
                    text: 'Floors:'
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.4
                TextInput:
                    id: floors
                    hint_text: 'Number of Floors'
                    input_filter: 'int'
                    multiline: False
                    background_color: 0.98, 0.98, 0.98, 1
                    foreground_color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.6
                    minimum_width: 120

                # Price
                Label:
                    id: price_label
                    text: 'Price:'
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.4
                TextInput:
                    id: price
                    hint_text: 'Property Price'
                    input_filter: 'float'
                    multiline: False
                    background_color: 0.98, 0.98, 0.98, 1
                    foreground_color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.6
                    minimum_width: 120

                # Currency
                Label:
                    id: currency_label
                    text: 'Currency:'
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.4
                Spinner:
                    id: currency
                    text: 'Select Currency'
                    values: root.currency_values if hasattr(root, 'currency_values') else []
                    background_color: 0.95, 0.95, 0.95, 1
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.6
                    minimum_width: 120

                # Unit
                Label:
                    id: unit_label
                    text: 'Unit:'
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.4
                Spinner:
                    id: unit
                    text: 'Select Unit'
                    values: root.unit_values if hasattr(root, 'unit_values') else []
                    background_color: 0.95, 0.95, 0.95, 1
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.6
                    minimum_width: 120

                # Photos
                Label:
                    id: photos_label
                    text: 'Photos:'
                    size_hint_y: None
                    height: 40
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_x: 0.4
                BoxLayout:
                    size_hint_y: None
                    height: 40
                    orientation: 'horizontal'
                    spacing: 10
                    size_hint_x: 0.6
                    Button:
                        id: add_photo_btn
                        text: 'Add Photos'
                        background_color: 0.3, 0.6, 0.9, 1
                        color: 1, 1, 1, 1
                        size_hint_x: 0.4
                        on_press: root.open_photo_chooser()
                    Label:
                        id: photo_count
                        text: 'No photos selected'
                        color: 0.5, 0.5, 0.5, 1
                        size_hint_x: 0.6
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.size

            # Photo Preview Gallery
            BoxLayout:
                size_hint_y: None
                height: 150
                orientation: 'vertical'
                spacing: 5

                Label:
                    text: 'Photo Preview'
                    size_hint_y: None
                    height: 30
                    color: 0.2, 0.2, 0.2, 1
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
                ScrollView:
                    do_scroll_y: False
                    do_scroll_x: True
                    size_hint_y: None
                    height: 115

                    GridLayout:
                        id: photo_gallery
                        rows: 1
                        size_hint_x: None
                        width: self.minimum_width
                        spacing: 10
                        height: 100




    BoxLayout:
        size_hint_y: None
        height: 50
        spacing: 10
        Button:
            id: save_btn
            text: 'Save'
            background_color: 0.2, 0.8, 0.3, 1
            color: 1, 1, 1, 1
            on_press: root.on_save() if hasattr(root, 'on_save') else None
        Button:
            id: cancel_btn
            text: 'Cancel'
            background_color: 0.8, 0.3, 0.3, 1
            color: 1, 1, 1, 1
            on_press: root.on_cancel() if hasattr(root, 'on_cancel') else None
<UpdateGUIScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 10
        spacing: 10
        canvas.before:
            Color:
                rgba: 1, 1, 1, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # Header with title and language switcher
        BoxLayout:
            size_hint_y: None
            height: 50
            Label:
                id: header_label
                text: 'Property Management'
                font_size: 24
                color: 0.2, 0.2, 0.2, 1

            # Language switcher button
            Button:
                id: language_btn
                text: 'Language'
                size_hint: None, None
                size: 120, 40
                pos_hint: {'center_y': 0.5}
                background_color: 0.2, 0.6, 0.9, 1
                color: 1, 1, 1, 1
                font_size: 14
                on_press: root.show_language_switcher()

        # Properties list header
        GridLayout:
            cols: 5
            size_hint_y: None
            height: 40
            Label:
                id: code_header
                text: 'Code'
                bold: True
                color: 0.2, 0.2, 0.2, 1
            Label:
                id: type_header
                text: 'Type'
                bold: True
                color: 0.2, 0.2, 0.2, 1
            Label:
                id: area_header
                text: 'Area'
                bold: True
                color: 0.2, 0.2, 0.2, 1
            Label:
                id: owner_header
                text: 'Owner'
                bold: True
                color: 0.2, 0.2, 0.2, 1
            Label:
                id: actions_header
                text: 'Actions'
                bold: True
                color: 0.2, 0.2, 0.2, 1

        # Properties list in a scrollview
        ScrollView:
            size_hint: 1, 1
            do_scroll_x: False
            GridLayout:
                id: properties_container
                cols: 1
                spacing: 2
                size_hint_y: None
                height: self.minimum_height

        # Back button
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: 60
            padding: 0, 10, 0, 0
            Button:
                id: back_btn
                text: 'Back to Main'
                size_hint: None, None
                size: 200, 50
                background_color: 0.4, 0.4, 0.8, 1
                color: 1, 1, 1, 1
                font_size: 16
                on_press: root.go_to_main_gui()
            Label:
                # Spacer
