<MainScreen>:
    name: 'main'
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1  # White background
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: '15dp'
        spacing: '10dp'

        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: '40dp'
            spacing: '10dp'

            Button:
                text: 'Exit'
                size_hint_x: None
                width: '100dp'
                background_color: 0.8, 0.2, 0.2, 1  # Red button
                color: 1, 1, 1, 1
                on_release: app.stop()

            Widget:

            Button:
                text: 'About'
                size_hint_x: None
                width: '100dp'
                background_color: 0.2, 0.2, 0.8, 1  # Blue button
                color: 1, 1, 1, 1
                on_release: app.root.current = 'about_gui'

        Label:
            text: 'Welcome to the Main Screen'
            font_size: '24sp'
            size_hint_y: None
            height: '50dp'
            color: 0.2, 0.2, 0.2, 1  # Dark gray text
            bold: True

        GridLayout:
            cols: 2
            padding: '15dp'
            spacing: '15dp'

            Button:
                text: 'New Property'
                on_release: app.root.current = 'insert_gui'
                background_color: 0.2, 0.6, 0.9, 1  # Blue button
                color: 1, 1, 1, 1  # White text
                font_size: '18sp'
                size_hint_y: None
                height: '60dp'

            Button:
                text: 'Update Property'
                on_release: app.root.current = 'update_gui'
                background_color: 0.2, 0.7, 0.5, 1  # Teal button
                color: 1, 1, 1, 1  # White text
                font_size: '18sp'
                size_hint_y: None
                height: '60dp'

            Button:
                text: 'Browse Property'
                on_release: app.root.current = 'browse_gui'
                background_color: 0.9, 0.5, 0.2, 1  # Orange button
                color: 1, 1, 1, 1  # White text
                font_size: '18sp'
                size_hint_y: None
                height: '60dp'

            Button:
                text: 'Upload Property'
                on_release: app.root.current = 'upload_gui'
                background_color: 0.5, 0.5, 0.5, 1  # Gray button
                color: 1, 1, 1, 1  # White text
                font_size: '18sp'
                size_hint_y: None
                height: '60dp'
