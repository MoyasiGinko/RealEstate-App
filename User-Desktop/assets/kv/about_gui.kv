<AboutScreen>:
	name: 'about_gui'
	canvas.before:
		Color:
			rgba: 0.95, 0.95, 0.95, 1
		Rectangle:
			pos: self.pos
			size: self.size

	BoxLayout:
		orientation: 'vertical'
		padding: '30dp'
		spacing: '20dp'

		Label:
			text: 'About Us'
			font_size: '28sp'
			color: 0.2, 0.2, 0.4, 1
			bold: True
			size_hint_y: None
			height: '60dp'
			halign: 'center'
			valign: 'middle'
			text_size: self.size

		BoxLayout:
			orientation: 'vertical'
			spacing: '10dp'
			size_hint_y: None
			height: '220dp'

			Label:
				text: 'Al-Kawaz Software and Information Technology'
				font_size: '22sp'
				color: 0.2, 0.3, 0.6, 1
				bold: True
				size_hint_y: None
				height: '40dp'
				halign: 'center'
				valign: 'middle'
				text_size: self.size

			Label:
				text: 'Version: 1.0.0'
				font_size: '16sp'
				color: 0.4, 0.4, 0.4, 1
				size_hint_y: None
				height: '30dp'
				halign: 'center'
				valign: 'middle'
				text_size: self.size

			Label:
				text: 'Author: Luay Alkawaz'
				font_size: '16sp'
				color: 0.4, 0.4, 0.4, 1
				size_hint_y: None
				height: '30dp'
				halign: 'center'
				valign: 'middle'
				text_size: self.size

			Label:
				text: "This application helps users manage real estate properties efficiently and intuitively.\nProfessional • Reliable • Innovative\nThank you for using our system!"
				font_size: '15sp'
				color: 0.5, 0.5, 0.5, 1
				size_hint_y: None
				height: '80dp'
				halign: 'center'
				valign: 'middle'
				text_size: self.size

		Widget:
			size_hint_y: 0.2

		BoxLayout:
			orientation: 'horizontal'
			size_hint_y: None
			height: '60dp'
			spacing: '20dp'
			padding: [0, 10, 0, 0]

			Button:
				text: '← Back to Main'
				size_hint: None, None
				size: '200dp', '50dp'
				background_color: 0.4, 0.4, 0.8, 1
				color: 1, 1, 1, 1
				font_size: '16sp'
				on_release: root.go_to_main_gui()
