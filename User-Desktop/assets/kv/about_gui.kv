<AboutScreen>:
	name: 'about_gui'
	canvas.before:
		Color:
			rgba: 1, 1, 1, 1  # Pure white background
		Rectangle:
			pos: self.pos
			size: self.size

	BoxLayout:
		orientation: 'vertical'
		padding: '30dp'
		spacing: '20dp'

		# Top navigation bar with language switcher
		BoxLayout:
			orientation: 'horizontal'
			size_hint_y: None
			height: '50dp'
			spacing: '15dp'

			# Language button
			Button:
				id: language_btn
				size_hint_x: None
				width: '120dp'
				text: 'Language'
				font_size: '14sp'
				background_color: 0.2, 0.8, 0.6, 1
				color: 1, 1, 1, 1
				on_release: root.show_language_switcher()

			Widget:
				size_hint_x: 1

		Label:
			text: 'About Us'
			id: about_title
			font_size: '28sp'
			color: 0, 0, 0, 1
			bold: True
			size_hint_y: None
			height: '60dp'
			halign: 'center'
			valign: 'middle'
			text_size: self.size

		BoxLayout:
			orientation: 'vertical'
			spacing: '10dp'
			size_hint_y: None
			height: '260dp'

			Image:
				source: 'assets/app-images/alkawaz-logo.jpg'
				size_hint: None, None
				size: '80dp', '80dp'
				allow_stretch: True
				keep_ratio: True
				mipmap: True
				opacity: 1
				pos_hint: {'center_x': 0.5}

			Label:
				text: 'Al-Kawaz Software and Information Technology'
				id: company_name_label
				font_size: '22sp'
				color: 0, 0, 0, 1
				bold: True
				size_hint_y: None
				height: '40dp'
				halign: 'center'
				valign: 'middle'
				text_size: self.size

			Label:
				text: 'Version: 1.0.0'
				id: version_label
				font_size: '16sp'
				color: 0, 0, 0, 1
				size_hint_y: None
				height: '30dp'
				halign: 'center'
				valign: 'middle'
				text_size: self.size

			Label:
				text: 'Author: Luay Alkawaz'
				id: author_label
				font_size: '16sp'
				color: 0, 0, 0, 1
				size_hint_y: None
				height: '30dp'
				halign: 'center'
				valign: 'middle'
				text_size: self.size

			Label:
				text: "This application helps users manage real estate properties efficiently and intuitively.\nProfessional • Reliable • Innovative\nThank you for using our system!"
				id: description_label
				font_size: '15sp'
				color: 0, 0, 0, 1
				size_hint_y: None
				height: '80dp'
				halign: 'center'
				valign: 'middle'
				text_size: self.size

		Widget:
			size_hint_y: 0.2

		BoxLayout:
			orientation: 'horizontal'
			size_hint_y: None
			height: '60dp'
			spacing: '20dp'
			padding: [0, 10, 0, 0]

			Button:
				text: 'Back to Main'
				id: back_btn
				size_hint: None, None
				size: '200dp', '50dp'
				background_color: 0.4, 0.4, 0.8, 1
				color: 1, 1, 1, 1
				font_size: '16sp'
				on_release: root.go_to_main_gui()
