<UploadScreen>:
    name: 'upload'

    # White background
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: 30
        spacing: 20

        # Screen title with language switcher
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: 60
            spacing: 20

            Label:
                id: screen_title
                text: 'Database Management'
                font_size: 32
                color: 0.1, 0.1, 0.1, 1
                bold: True
                halign: 'left'
                valign: 'middle'
                text_size: self.size

            # Language switcher button
            Button:
                id: language_btn
                text: 'Language'
                size_hint: None, None
                size: 120, 40
                pos_hint: {'center_y': 0.5}
                background_color: 0.2, 0.6, 0.9, 1
                color: 1, 1, 1, 1
                font_size: 14
                on_press: root.show_language_switcher()

        # Description
        Label:
            id: description_label
            text: 'Manage your database: reset, backup, seed with sample data, or upload a new database file'
            font_size: 16
            size_hint_y: None
            height: 40
            color: 0.4, 0.4, 0.4, 1
            text_size: self.width, None
            halign: 'center'

        # Spacer
        Widget:
            size_hint_y: 0.1

        # Main buttons grid
        GridLayout:
            cols: 2
            spacing: 20
            size_hint_y: None
            height: 300
            row_default_height: 140

            # Reset Database button
            BoxLayout:
                orientation: 'vertical'
                spacing: 10

                Button:
                    id: reset_db_btn
                    text: 'Reset Database'
                    font_size: 18
                    background_color: 0.8, 0.2, 0.2, 1
                    color: 1, 1, 1, 1
                    size_hint_y: None
                    height: 80
                    on_press: root.create_fresh_database(self)

                Label:
                    id: reset_db_description
                    text: 'Create a fresh empty database\n(Deletes all existing data)'
                    font_size: 12
                    color: 0.5, 0.5, 0.5, 1
                    text_size: self.width, None
                    halign: 'center'
                    size_hint_y: None
                    height: 50

            # Export Database button
            BoxLayout:
                orientation: 'vertical'
                spacing: 10

                Button:
                    id: export_db_btn
                    text: 'Export Database'
                    font_size: 18
                    background_color: 0.2, 0.6, 0.8, 1
                    color: 1, 1, 1, 1
                    size_hint_y: None
                    height: 80
                    on_press: root.export_database(self)

                Label:
                    id: export_db_description
                    text: 'Create a backup copy of\nyour current database'
                    font_size: 12
                    color: 0.5, 0.5, 0.5, 1
                    text_size: self.width, None
                    halign: 'center'
                    size_hint_y: None
                    height: 50

            # Seed Database button
            BoxLayout:
                orientation: 'vertical'
                spacing: 10

                Button:
                    id: seed_db_btn
                    text: 'Seed Database'
                    font_size: 18
                    background_color: 0.6, 0.8, 0.2, 1
                    color: 1, 1, 1, 1
                    size_hint_y: None
                    height: 80
                    on_press: root.seed_database(self)

                Label:
                    id: seed_db_description
                    text: 'Add sample data to database\n(Preserves existing data)'
                    font_size: 12
                    color: 0.5, 0.5, 0.5, 1
                    text_size: self.width, None
                    halign: 'center'
                    size_hint_y: None
                    height: 50

            # Upload Database button
            BoxLayout:
                orientation: 'vertical'
                spacing: 10

                Button:
                    id: upload_db_btn
                    text: 'Upload Database'
                    font_size: 18
                    background_color: 0.8, 0.6, 0.2, 1
                    color: 1, 1, 1, 1
                    size_hint_y: None
                    height: 80
                    on_press: root.upload_database(self)

                Label:
                    id: upload_db_description
                    text: 'Replace current database\nwith a new file'
                    font_size: 12
                    color: 0.5, 0.5, 0.5, 1
                    text_size: self.width, None
                    halign: 'center'
                    size_hint_y: None
                    height: 50

        # Spacer
        Widget:
            size_hint_y: 0.2

        # Back button
        Button:
            id: back_btn
            text: 'Back to Main'
            font_size: 16
            size_hint_y: None
            height: 50
            size_hint_x: 0.3
            pos_hint: {'center_x': 0.5}
            background_color: 0.6, 0.6, 0.6, 1
            color: 1, 1, 1, 1
            on_press: root.go_to_main_gui(self)